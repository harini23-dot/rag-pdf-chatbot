# Choose one provider: anthropic | openai | ollama
LLM_PROVIDER=anthropic

# Fill in the key for the provider you chose (not needed for ollama)
ANTHROPIC_API_KEY=your-key-here
OPENAI_API_KEY=your-key-here

# Optional: override the default model names
# LLM_MODEL=claude-haiku-5-5
# Optional: tuning
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# TOP_K=4
